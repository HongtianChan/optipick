{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/favicon.svg",
      "destination": "/web-ui/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/web-ui/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/web-ui/index.html"
    }
  ]
}
